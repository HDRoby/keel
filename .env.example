# Where Keel keeps its workspace (projects and keel.db). Default: ~/.keel
KEEL_HOME=

# Use "fake" for scripted replies in tests. Leave empty to use the providers set in Settings.
KEEL_PROVIDER=

# API keys are entered in Settings and stored encrypted. Do not put them here.

# Minutes between read-back checks of pushed repositories. Default 15; 0 turns the schedule off.
KEEL_READBACK_MINUTES=

# Tests only: allow pushing to local bare repositories instead of GitHub.
KEEL_ALLOW_LOCAL_REMOTES=
