# The folder Keel works on. `npx keel [path]` sets it; set it yourself only for `npm run dev`.
KEEL_PROJECT_DIR=

# Your settings and keys (settings.json, secret.key). Default: $XDG_CONFIG_HOME/keel or ~/.config/keel
KEEL_USER_DIR=

# Use "fake" for scripted replies in tests. Leave empty to use the providers set in Settings.
KEEL_PROVIDER=

# API keys are entered in Settings and stored encrypted in the user config folder. Do not put them here.

# Seconds between read-back checks of the folder. Default 60; 0 turns the schedule off.
KEEL_READBACK_SECONDS=
